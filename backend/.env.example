PORT=5000
NODE_ENV=development
JWT_SECRET=padosipro_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
DATABASE_PATH=./data/padosipro.sqlite

# OTP Settings
OTP_EXPIRY_MINUTES=10
